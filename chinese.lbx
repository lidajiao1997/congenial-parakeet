  circa            = {{约}{约}},
  spring           = {{春}{春}},
  summer           = {{夏}{夏}},
  autumn           = {{秋}{秋}},
  winter           = {{冬}{冬}},
  % ============ 月份 ============
  january          = {{一月}{1月}},
  february         = {{二月}{2月}},
  march            = {{三月}{3月}},
  april            = {{四月}{4月}},
  may              = {{五月}{5月}},
  june             = {{六月}{6月}},
  july             = {{七月}{7月}},
  august           = {{八月}{8月}},
  september        = {{九月}{9月}},
  october          = {{十月}{10月}},
