  % ============ 杂项 ============
  sequens          = {{以下}{以下}},
  sequentes        = {{以下}{以下}},
  newseries        = {{新辑}{新辑}},
  oldseries        = {{旧辑}{旧辑}},
  shorthands       = {{缩略语表}{缩略语}},
  bibliography     = {{参考文献}{参考文献}},
  references       = {{引用文献}{引用文献}},
}

\endinput
